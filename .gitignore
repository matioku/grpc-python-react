# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Stubs User (Module 1) — générés dans protos/
protos/*_pb2.py
protos/*_pb2.pyi
protos/*_pb2_grpc.py

# Stubs Chat (Module 2) — générés dans generated/
generated/*_pb2.py
generated/*_pb2.pyi
generated/*_pb2_grpc.py
!generated/__init__.py

# Stubs grpc-web (Module 3) — générés dans frontend/src/generated/ (npm run proto)
frontend/src/generated/*
!frontend/src/generated/package.json

# Certificats (Module 5) — générés localement, jamais commités
certs/*.key
certs/*.crt
certs/*.csr
!certs/.gitkeep
